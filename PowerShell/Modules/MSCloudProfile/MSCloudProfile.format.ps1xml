<?xml version="1.0" encoding="utf-8"?>
<!--
Program: MSCloudProfile.format.ps1xml
Description: Defines list-format default console views for MSCloudProfile Get commands.
Context: Personal cross-host PowerShell profile.
Author: Greg Tate
-->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>MSCloudProfile.CurrentAzProfile</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.CurrentAzProfile</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries><ListEntry><ListItems>
          <ListItem><Label>Profile</Label><PropertyName>ProfileName</PropertyName></ListItem>
          <ListItem><Label>Logged In</Label><PropertyName>LoggedIn</PropertyName></ListItem>
          <ListItem><Label>User</Label><PropertyName>User</PropertyName></ListItem>
          <ListItem><Label>Subscription</Label><PropertyName>Subscription</PropertyName></ListItem>
          <ListItem><Label>Tenant</Label><PropertyName>TenantId</PropertyName></ListItem>
          <ListItem><Label>Synchronized</Label><PropertyName>ContextSynchronized</PropertyName></ListItem>
        </ListItems></ListEntry></ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>MSCloudProfile.CurrentMgProfile</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.CurrentMgProfile</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries><ListEntry><ListItems>
          <ListItem><Label>Profile</Label><PropertyName>ProfileName</PropertyName></ListItem>
          <ListItem><Label>Logged In</Label><PropertyName>MgLoggedIn</PropertyName></ListItem>
          <ListItem><Label>Account</Label><PropertyName>MgAccount</PropertyName></ListItem>
          <ListItem><Label>Tenant</Label><PropertyName>MgTenantId</PropertyName></ListItem>
          <ListItem><Label>Auth Type</Label><PropertyName>MgAuthType</PropertyName></ListItem>
          <ListItem><Label>Synchronized</Label><PropertyName>ContextSynchronized</PropertyName></ListItem>
        </ListItems></ListEntry></ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>MSCloudProfile.AzProfile</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.AzProfile</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries><ListEntry><ListItems>
          <ListItem><Label>Name</Label><PropertyName>Name</PropertyName></ListItem>
          <ListItem><Label>Description</Label><PropertyName>Description</PropertyName></ListItem>
          <ListItem><Label>Account</Label><PropertyName>Account</PropertyName></ListItem>
          <ListItem><Label>Source</Label><PropertyName>ConfigSource</PropertyName></ListItem>
          <ListItem><Label>Logged In</Label><PropertyName>LoggedIn</PropertyName></ListItem>
          <ListItem><Label>Tenant</Label><PropertyName>TenantId</PropertyName></ListItem>
          <ListItem><Label>Subscription ID</Label><PropertyName>SubscriptionId</PropertyName></ListItem>
        </ListItems></ListEntry></ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>MSCloudProfile.MgProfile</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.MgProfile</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries><ListEntry><ListItems>
          <ListItem><Label>Name</Label><PropertyName>Name</PropertyName></ListItem>
          <ListItem><Label>Active</Label><PropertyName>IsActive</PropertyName></ListItem>
          <ListItem><Label>Account</Label><PropertyName>Account</PropertyName></ListItem>
          <ListItem><Label>Source</Label><PropertyName>ConfigSource</PropertyName></ListItem>
          <ListItem><Label>Tenant</Label><PropertyName>TenantId</PropertyName></ListItem>
          <ListItem><Label>Cached</Label><PropertyName>HasCache</PropertyName></ListItem>
        </ListItems></ListEntry></ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>MSCloudProfile.Configuration</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.Configuration</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries><ListEntry><ListItems>
          <ListItem><Label>Source</Label><PropertyName>Name</PropertyName></ListItem>
          <ListItem><Label>Path</Label><PropertyName>Path</PropertyName></ListItem>
          <ListItem><Label>Exists</Label><PropertyName>Exists</PropertyName></ListItem>
          <ListItem><Label>Loaded</Label><PropertyName>Loaded</PropertyName></ListItem>
          <ListItem><Label>Profiles</Label><PropertyName>ProfileCount</PropertyName></ListItem>
          <ListItem><Label>Precedence</Label><PropertyName>Precedence</PropertyName></ListItem>
        </ListItems></ListEntry></ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>