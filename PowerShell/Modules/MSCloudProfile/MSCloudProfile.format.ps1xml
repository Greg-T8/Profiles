<?xml version="1.0" encoding="utf-8"?>
<!--
Program: MSCloudProfile.format.ps1xml
Description: Defines compact default console views for MSCloudProfile Get commands.
Context: Personal cross-host PowerShell profile.
Author: Greg Tate
-->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>MSCloudProfile.CurrentAzProfile</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.CurrentAzProfile</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Profile</Label></TableColumnHeader>
          <TableColumnHeader><Label>Logged In</Label></TableColumnHeader>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>Subscription</Label></TableColumnHeader>
          <TableColumnHeader><Label>Tenant</Label></TableColumnHeader>
          <TableColumnHeader><Label>Synchronized</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>ProfileName</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LoggedIn</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Subscription</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>TenantId</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ContextSynchronized</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>MSCloudProfile.CurrentMgProfile</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.CurrentMgProfile</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Profile</Label></TableColumnHeader>
          <TableColumnHeader><Label>Logged In</Label></TableColumnHeader>
          <TableColumnHeader><Label>Account</Label></TableColumnHeader>
          <TableColumnHeader><Label>Tenant</Label></TableColumnHeader>
          <TableColumnHeader><Label>Auth Type</Label></TableColumnHeader>
          <TableColumnHeader><Label>Synchronized</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>ProfileName</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>MgLoggedIn</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>MgAccount</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>MgTenantId</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>MgAuthType</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ContextSynchronized</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>MSCloudProfile.AzProfile</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.AzProfile</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Description</Label></TableColumnHeader>
          <TableColumnHeader><Label>Account</Label></TableColumnHeader>
          <TableColumnHeader><Label>Source</Label></TableColumnHeader>
          <TableColumnHeader><Label>Logged In</Label></TableColumnHeader>
          <TableColumnHeader><Label>Tenant</Label></TableColumnHeader>
          <TableColumnHeader><Label>Subscription ID</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Account</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ConfigSource</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>LoggedIn</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>TenantId</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>SubscriptionId</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>MSCloudProfile.MgProfile</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.MgProfile</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Active</Label></TableColumnHeader>
          <TableColumnHeader><Label>Account</Label></TableColumnHeader>
          <TableColumnHeader><Label>Source</Label></TableColumnHeader>
          <TableColumnHeader><Label>Tenant</Label></TableColumnHeader>
          <TableColumnHeader><Label>Cached</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>IsActive</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Account</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ConfigSource</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>TenantId</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>HasCache</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>MSCloudProfile.Configuration</Name>
      <ViewSelectedBy><TypeName>MSCloudProfile.Configuration</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Source</Label></TableColumnHeader>
          <TableColumnHeader><Label>Path</Label></TableColumnHeader>
          <TableColumnHeader><Label>Exists</Label></TableColumnHeader>
          <TableColumnHeader><Label>Loaded</Label></TableColumnHeader>
          <TableColumnHeader><Label>Profiles</Label></TableColumnHeader>
          <TableColumnHeader><Label>Precedence</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries><TableRowEntry><TableColumnItems>
          <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Path</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Exists</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Loaded</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>ProfileCount</PropertyName></TableColumnItem>
          <TableColumnItem><PropertyName>Precedence</PropertyName></TableColumnItem>
        </TableColumnItems></TableRowEntry></TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>