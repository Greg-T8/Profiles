#!/bin/sh

# -------------------------------------------------------------------------
# Program: prepare-commit-msg
# Description: Generate a Git commit message from staged changes with Copilot
# Context: Personal Git workflow - bounded Copilot commit-message generation
# Author: Greg Tate
# -------------------------------------------------------------------------

MSG_FILE="$1"
SOURCE="$2"
HOOK_DIRECTORY=$(cd "$(dirname -- "$0")" && pwd -W)
REPOSITORY_PATH=$(git rev-parse --show-toplevel)
COPILOT_MODEL="${COPILOT_COMMIT_MODEL:-mai-code-1.1-flash}"

# Only generate a message for a normal Git commit.
if [ -n "$SOURCE" ]; then
    exit 0
fi

# Exit when there are no staged changes to describe.
if git diff --cached --quiet; then
    exit 0
fi

echo "Generating commit message with GitHub Copilot..." >&2

# Delegate prompt selection and Copilot invocation to the sibling PowerShell script.
MESSAGE="$(
    pwsh -NoProfile -NoLogo -NonInteractive \
        -File "$HOOK_DIRECTORY/Get-CopilotCommitMessage.ps1" \
        -RepositoryPath "$REPOSITORY_PATH" \
        -Model "$COPILOT_MODEL"
)"

COPILOT_STATUS=$?

# Abort the commit when Copilot cannot provide a usable message.
if [ $COPILOT_STATUS -ne 0 ] || [ -z "$MESSAGE" ]; then
    echo "Copilot failed to generate a commit message." >&2
    exit 1
fi

# Replace the default message only after Copilot returns a usable response.
printf '%s\n' "$MESSAGE" > "$MSG_FILE"