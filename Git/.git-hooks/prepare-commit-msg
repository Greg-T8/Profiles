#!/bin/sh

# -------------------------------------------------------------------------
# Program: prepare-commit-msg
# Description: Generate a Git commit message from staged changes with AI
# Context: Personal Git workflow - bounded AI commit-message generation
# Author: Greg Tate
# -------------------------------------------------------------------------

# Resolve the commit message target and shared generator location.
MSG_FILE="$1"
SOURCE="$2"
HOOK_DIRECTORY=$(cd "$(dirname -- "$0")" && pwd -W)
REPOSITORY_PATH=$(git rev-parse --show-toplevel)

# Only generate a message for a normal Git commit.
if [ -n "$SOURCE" ]; then
    exit 0
fi

# Exit when there are no staged changes to describe.
if git diff --cached --quiet; then
    exit 0
fi

echo "Generating commit message with the AI API..." >&2

# Delegate prompt selection and AI invocation to the sibling PowerShell script.
MESSAGE="$(
    pwsh -NoProfile -NoLogo -NonInteractive \
        -File "$HOOK_DIRECTORY/Get-AICommitMessage.ps1" \
        -RepositoryPath "$REPOSITORY_PATH"
)"

# Retain the generator status before inspecting its output.
AI_STATUS=$?

# Abort the commit when AI cannot provide a usable message.
if [ $AI_STATUS -ne 0 ] || [ -z "$MESSAGE" ]; then
    echo "AI failed to generate a commit message." >&2
    exit 1
fi

# Replace the default message only after AI returns a usable response.
printf '%s\n' "$MESSAGE" > "$MSG_FILE"
